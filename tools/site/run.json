  "lines": [
    {
      "id": "neuro-prof-1",
      "who": "prof",
      "voice": "am_eric",
      "text": "Library's open late tonight. Mind the stacks, and look behind the shelves."
    },
    {
      "id": "neuro-prof-2",
      "who": "prof",
      "voice": "am_eric",
      "text": "Synapses fire when you land on them. Ride the signal across."
    },
    {
      "id": "tj-porter-1",
      "who": "porter",
      "voice": "am_onyx",
      "text": "Evening. Lot's closed and the lamps are on. Mind the puddles."
    },
    {
      "id": "tj-porter-2",
      "who": "porter",
      "voice": "am_onyx",
      "text": "Keys are up on the roofs. The showroom's at the far end."
    },
    {
      "id": "ltt-buyer-1",
      "who": "buyer",
      "voice": "af_bella",
      "text": "I brought my license. Do I have to fill out every form?"
    },
    {
      "id": "ltt-buyer-2",
      "who": "buyer",
      "voice": "af_bella",
      "text": "That's it? Can we do the rest in Spanish?"
    },
    {
      "id": "in-caller-1",
      "who": "caller",
      "voice": "af_nicole",
      "text": "Hi, I saw a car on your site. Can I come see it Saturday?"
    },
    {
      "id": "in-agent-1",
      "who": "agent",
      "voice": "af_heart",
      "text": "I can book that for you. Saturday it is."
    },
    {
      "id": "in-caller-2",
      "who": "caller",
      "voice": "af_nicole",
      "text": "One more thing. Can I talk to someone about financing?"
    },
    {
      "id": "in-agent-2",
      "who": "agent",
      "voice": "af_heart",
      "text": "Of course. Transferring you to the team now."
    },
    {
      "id": "pr-seller-1",
      "who": "seller",
      "voice": "am_liam",
      "text": "Still have the truck listed. You already read the whole listing?"
    },
    {
      "id": "pr-seller-2",
      "who": "seller",
      "voice": "am_liam",
      "text": "Fair enough. Text me and we'll talk."
    },
    {
      "id": "ob-dealer-1",
      "who": "dealer",
      "voice": "am_fenrir",
      "text": "Heard you're building a sale desk. Can I sign up today?"
    },
    {
      "id": "ob-dealer-2",
      "who": "dealer",
      "voice": "am_fenrir",
      "text": "Then let's have the conversation."
    }
  ],
  "me": [
    {
      "id": "me-neuro-1",
      "text": "I'm studying neuroscience at UT Austin, expected 2028."
    },
    {
      "id": "me-neuro-2",
      "text": "I earned an Associate of Arts in Business at San Jacinto College in May 2026."
    },
    {
      "id": "me-tj-1",
      "text": "I've owned and run Triple J since August 2024."
    },
    {
      "id": "me-tj-2",
      "text": "Since June 2025 I've personally closed 53 vehicle sales."
    },
    {
      "id": "me-ltt-1",
      "text": "Scan it once. Every form fills itself."
    },
    {
      "id": "me-ltt-2",
      "text": "English or Spanish, one plain question at a time."
    },
    {
      "id": "me-in-1",
      "text": "My voice AI books appointments into the CRM."
    },
    {
      "id": "me-in-2",
      "text": "Calls it can't resolve go live to my staff."
    },
    {
      "id": "me-pr-1",
      "text": "My workflow researches Facebook Marketplace leads and writes the findings to the CRM."
    },
    {
      "id": "me-pr-2",
      "text": "Follow-up replies come from SOPs I wrote."
    },
    {
      "id": "me-ob-1",
      "text": "Obavia is a sale desk I'm building for Texas independent dealers. It's in development."
    },
    {
      "id": "me-ob-2",
      "text": "Not yet. Early access is a conversation, not an account."
    }
  ],
